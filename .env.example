# Copy to .env and fill in. .env is gitignored and is not deployed by
# deploy.sh - it lives only on the Pi.

WYZE_EMAIL=
WYZE_PASSWORD=

# WYZE_KEY_ID and WYZE_API_KEY are issued together at
# https://developer-api-console.wyze.com and are only valid as a matched pair.
# Regenerating the API key invalidates the old key id, so ALWAYS replace both.
#
# Replacing just one fails with HTTP 400 / errorCode 1000, "Invalid credentials,
# please check username, password, keyid or apikey" - the same error Wyze
# returns for a wrong password, so it reads like a password problem and is not.
# Run wyze_auth_check.py on the Pi to see the raw response body, which wyze-sdk
# hides behind raise_for_status().
WYZE_KEY_ID=
WYZE_API_KEY=
